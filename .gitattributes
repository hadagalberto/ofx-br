# Every text file is stored with LF in the repository and checked out with LF
# on every OS. Windows checkouts must not turn sources into CRLF, otherwise
# `prettier --check` (endOfLine: lf) fails on all checked files.
* text=auto eol=lf

# Fixture bytes are the test data: CRLF, LF, CR-only, NUL and UTF-16 layouts
# are deliberate. Never let Git normalize them on checkout/commit. Any future
# byte-exact fixture must likewise be declared with `-text` (or `binary`).
*.ofx -text
